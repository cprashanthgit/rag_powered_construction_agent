# ══════════════════════════════════════════════════════════════════════
# deploy/.env.cloud.example — Production secrets template
#
# INSTRUCTIONS:
#   1. On your GCP VM, copy this file:
#        cp deploy/.env.cloud.example deploy/.env.prod
#   2. Fill in every value marked  ← REQUIRED
#   3. Run:
#        docker compose -f deploy/docker-compose.cloud.yml up -d --build
#
# NEVER commit .env.prod to git — it is in .gitignore
# ══════════════════════════════════════════════════════════════════════

# ─── LLM + Embedding Mode (always Mode 2 in cloud) ────────────────────
EMBEDDING_BACKEND=openai
LLM_BACKEND=openai
LLM_MODEL=gpt-3.5-turbo
VECTOR_BACKEND=pinecone

# ─── OpenAI ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...                   # ← REQUIRED

# ─── Pinecone ──────────────────────────────────────────────────────────
PINECONE_API_KEY=pcsk_...                    # ← REQUIRED
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME_OPENAI=cnst-openai

# ─── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_HOST=postgres                       # Docker service name — do not change
POSTGRES_PORT=5432
POSTGRES_DB=cnst_rag
POSTGRES_USER=cnst_user
POSTGRES_PASSWORD=                           # ← REQUIRED (20+ char strong password)

# ─── Redis ─────────────────────────────────────────────────────────────
REDIS_HOST=redis                             # Docker service name — do not change
REDIS_PORT=6379

# ─── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET_KEY=                              # ← REQUIRED
                                             # Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Grafana ───────────────────────────────────────────────────────────
GRAFANA_PASSWORD=                            # ← REQUIRED (admin dashboard password)

# ─── RAG Pipeline ──────────────────────────────────────────────────────
HYBRID_SEARCH_ENABLED=true
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=5
BM25_TOP_K=15
DENSE_TOP_K=15
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SESSION_MEMORY_ENABLED=true

# ─── LangSmith (optional) ──────────────────────────────────────────────
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=cnst-rag-cloud
