{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Construction RAG Assistant — Real-time observability dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [

    {
      "id": 1,
      "title": "Total Queries (Last 24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "cnst-prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 10 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cnst-prometheus" },
          "expr": "sum(increase(rag_queries_total[24h]))",
          "legendFormat": "Total Queries",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "title": "Total Queries (All Time)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "postgres", "uid": "cnst-postgres" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "cnst-postgres" },
          "editorMode": "code",
          "rawSql": "SELECT COUNT(*) AS total FROM query_log",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "title": "User Satisfaction %",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "postgres", "uid": "cnst-postgres" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green",  "value": 75 }
            ]
          },
          "unit": "percent"
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "cnst-postgres" },
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(ROUND(AVG(CASE WHEN rating = 1 THEN 100.0 ELSE 0 END), 1), 0) AS satisfaction_pct FROM feedback",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "title": "Avg Response Time",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "cnst-postgres" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 10000 },
              { "color": "red",    "value": 30000 }
            ]
          },
          "unit": "ms"
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "cnst-postgres" },
          "editorMode": "code",
          "rawSql": "SELECT ROUND(AVG(total_ms)) AS avg_response_ms FROM query_log WHERE created_at > NOW() - INTERVAL '24 hours'",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "title": "Total Feedback Received",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "postgres", "uid": "cnst-postgres" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "cnst-postgres" },
          "editorMode": "code",
          "rawSql": "SELECT COUNT(*) AS total_feedback FROM feedback",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "title": "Query Rate Over Time (Prometheus)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "cnst-prometheus" },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cnst-prometheus" },
          "expr": "sum(increase(rag_queries_total[1h])) by (user_role)",
          "legendFormat": "{{user_role}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 7,
      "title": "Queries Per Day (PostgreSQL)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "postgres", "uid": "cnst-postgres" },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "cnst-postgres" },
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('hour', created_at) AS time, COUNT(*) AS queries FROM query_log GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },

    {
      "id": 8,
      "title": "Feedback Breakdown",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "postgres", "uid": "cnst-postgres" },
      "options": {
        "pieType": "donut",
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "right" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "cnst-postgres" },
          "editorMode": "code",
          "rawSql": "SELECT SUM(CASE WHEN rating = 1 THEN 1 ELSE 0 END)::int AS \"Positive\", SUM(CASE WHEN rating = -1 THEN 1 ELSE 0 END)::int AS \"Negative\" FROM feedback",
          "format": "table",
          "refId": "A"
        }
      ]
    },

    {
      "id": 9,
      "title": "Recent Queries",
      "type": "table",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 12 },
      "datasource": { "type": "postgres", "uid": "cnst-postgres" },
      "options": {
        "showHeader": true,
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "cnst-postgres" },
          "editorMode": "code",
          "rawSql": "SELECT created_at AS time, query AS question, total_ms, cache_hit, user_role FROM query_log ORDER BY created_at DESC LIMIT 20",
          "format": "table",
          "refId": "A"
        }
      ]
    }

  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["rag", "construction", "ai"],
  "templating": { "list": [] },
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Construction RAG Assistant",
  "uid": "cnst-rag-dashboard",
  "version": 3,
  "weekStart": ""
}
